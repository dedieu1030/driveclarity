# ── Firebase Cloud Functions secrets ────────────────────────────────────────
# Set these with: firebase functions:secrets:set SECRET_NAME
# Or for local emulator: create functions/.env from this file

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
APP_URL=https://driveclarity.app

# ── Apps Script properties ──────────────────────────────────────────────────
# Set in: Extensions → Apps Script → Project Settings → Script Properties

FIREBASE_FUNCTIONS_BASE_URL=https://us-central1-YOUR_FIREBASE_PROJECT.cloudfunctions.net
