# Firebase project (created for this repo)
# Console: https://console.firebase.google.com/project/driveaccessviewer-dedieu/overview
# ⚠️ Cloud Functions require the Blaze plan — upgrade first:
#    https://console.firebase.google.com/project/driveaccessviewer-dedieu/usage/details
#
# After Blaze + deploy:
#   cd functions && npm install && cd .. && firebase deploy --only functions --project driveaccessviewer-dedieu
#
# Apps Script → Script Properties:
#   FIREBASE_FUNCTIONS_BASE_URL=https://us-central1-driveaccessviewer-dedieu.cloudfunctions.net
#
# Set secrets (Stripe real keys replace placeholders):
#   printf '%s' 'sk_live_...' | firebase functions:secrets:set STRIPE_SECRET_KEY --project driveaccessviewer-dedieu --data-file=-
#   printf '%s' 'whsec_...'  | firebase functions:secrets:set STRIPE_WEBHOOK_SECRET --project driveaccessviewer-dedieu --data-file=-
#   printf '%s' 'price_...'  | firebase functions:secrets:set STRIPE_PRICE_ID --project driveaccessviewer-dedieu --data-file=-
#   printf '%s' 'https://driveclarity.app' | firebase functions:secrets:set APP_URL --project driveaccessviewer-dedieu --data-file=-

FIREBASE_FUNCTIONS_BASE_URL=https://us-central1-driveaccessviewer-dedieu.cloudfunctions.net
